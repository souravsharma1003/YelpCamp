<% layout("layouts/boilerplate") %>

    <h1>Edit <%=campground.title%></h1>

    <form action="/campgrounds/<%= campground._id %>?_method=PUT" method="POST">
        
        <div>
            <label for="title">Title</label><br>
            <input type="text" value="<%= campground.title %>" id="title" name="title" required>
        </div>
        <br>
        <div>
            <label for="price">Price</label><br>
            <input value="<%= campground.price %>" type="text" id="price" name="price" required>
        </div>
        <br>
        <div>
            <label for="location">Location</label><br>
            <input value="<%= campground.location %>" type="text" id="location" name="location" required>
        </div>
        <br>       
        <button type="submit">Save Changes</button>
    </form>
    <footer>
        <a href="/campgrounds/<%= campground._id %>">Back To Campground</a>
    </footer>

